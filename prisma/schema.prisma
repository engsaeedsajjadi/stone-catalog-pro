generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  password           String
  name               String
  phone              String?
  role               String               @default("OPERATOR")
  isActive           Boolean              @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  activities         ActivityLog[]
  customers          Customer[]           @relation("CustomerAssignee")
  emailVerifications EmailVerification[]
  inquiries          Inquiry[]
  orders             Order[]
  passwordResets     PasswordResetToken[]
  ownedDeals         SalesDeal[]
  sessions           Session[]
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id                String      @id @default(cuid())
  name              String
  nameEn            String?
  nameAr            String?
  nameRu            String?
  nameTr            String?
  slug              String      @unique
  description       String?
  descriptionEn     String?
  parentId          String?
  image             String?
  imageMediaAssetId String?     @unique
  icon              String?
  order             Int         @default(0)
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  imageMediaAsset   MediaAsset? @relation(fields: [imageMediaAssetId], references: [id])
  parent            Category?   @relation("CategoryTree", fields: [parentId], references: [id])
  children          Category[]  @relation("CategoryTree")
  stones            Stone[]

  @@index([imageMediaAssetId])
}

model Stone {
  id                  String          @id @default(cuid())
  name                String
  nameEn              String?
  nameAr              String?
  nameRu              String?
  nameTr              String?
  code                String          @unique
  categoryId          String
  quarry              String?
  quarryEn            String?
  country             String?
  color               String?
  colorSecondary      String?
  pattern             String?
  processingType      String?
  surfaceFinish       String?
  thickness           String?
  width               String?
  length              String?
  weight              String?
  waterAbsorption     String?
  compressiveStrength String?
  abrasionResistance  String?
  density             String?
  application         String?
  suitableFor         String?
  exportCountries     String?
  features            String?
  description         String?
  descriptionEn       String?
  tags                String?
  slug                String?         @unique
  isFeatured          Boolean         @default(false)
  isNewest            Boolean         @default(false)
  isBestSeller        Boolean         @default(false)
  isExportGrade       Boolean         @default(false)
  status              String          @default("AVAILABLE")
  viewCount           Int             @default(0)
  likeCount           Int             @default(0)
  rating              Float           @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  inquiries           Inquiry[]
  inventory           Inventory[]
  orderItems          OrderItem[]
  quotationItems      QuotationItem[]
  category            Category        @relation(fields: [categoryId], references: [id])
  auditLogs           StoneAuditLog[]
  images              StoneImage[]
  prices              StonePrice[]
  videos              StoneVideo[]
}

model MediaAsset {
  id           String       @id @default(cuid())
  storageKey   String       @unique
  url          String       @unique
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  altText      String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  categories   Category?
  images       StoneImage[]
}

model StoneImage {
  id           String      @id @default(cuid())
  stoneId      String
  url          String
  thumbnail    String?
  alt          String?
  type         String      @default("GALLERY")
  isPrimary    Boolean     @default(false)
  order        Int         @default(0)
  mediaAssetId String?
  createdAt    DateTime    @default(now())
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id])
  stone        Stone       @relation(fields: [stoneId], references: [id], onDelete: Cascade)

  @@index([mediaAssetId])
}

model StoneVideo {
  id        String   @id @default(cuid())
  stoneId   String
  url       String
  type      String   @default("YOUTUBE")
  title     String?
  createdAt DateTime @default(now())
  stone     Stone    @relation(fields: [stoneId], references: [id], onDelete: Cascade)
}

model StonePrice {
  id          String    @id @default(cuid())
  stoneId     String
  type        String
  amount      Float
  currency    String    @default("IRR")
  minQuantity Float?
  discount    Float     @default(0)
  validFrom   DateTime  @default(now())
  validUntil  DateTime?
  notes       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  stone       Stone     @relation(fields: [stoneId], references: [id], onDelete: Cascade)

  @@index([stoneId, type, currency])
  @@index([stoneId, validFrom])
  @@index([stoneId, currency])
}

model Warehouse {
  id        String      @id @default(cuid())
  name      String
  code      String      @unique
  location  String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  inventory Inventory[]
}

model Inventory {
  id              String    @id @default(cuid())
  stoneId         String
  warehouseId     String
  slabCount       Int       @default(0)
  totalSqm        Float     @default(0)
  reservedSqm     Float     @default(0)
  availableSqm    Float     @default(0)
  inProductionSqm Float     @default(0)
  blockCount      Int       @default(0)
  location        String?
  lastUpdated     DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  stone           Stone     @relation(fields: [stoneId], references: [id], onDelete: Cascade)
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([stoneId, warehouseId])
  @@index([warehouseId])
}

model Customer {
  id           String                @id @default(cuid())
  name         String
  companyName  String?
  email        String?
  phone        String
  country      String?
  city         String?
  address      String?
  customerType String                @default("RETAIL")
  status       String                @default("NEW")
  source       String?
  assigneeId   String?
  notes        String?
  tags         String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  assignee     User?                 @relation("CustomerAssignee", fields: [assigneeId], references: [id])
  interactions CustomerInteraction[]
  inquiries    Inquiry[]
  orders       Order[]
  quotations   Quotation[]
  deals        SalesDeal[]

  @@index([phone])
  @@index([email])
}

model CustomerInteraction {
  id         String    @id @default(cuid())
  customerId String
  type       String
  subject    String
  content    String?
  outcome    String?
  followUpAt DateTime?
  createdAt  DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([followUpAt])
}

model Inquiry {
  id              String    @id @default(cuid())
  customerId      String?
  customerName    String
  customerPhone   String
  customerEmail   String?
  customerCountry String?
  customerCity    String?
  stoneId         String?
  inquiryType     String    @default("PRICE_INQUIRY")
  message         String?
  requiredSqm     Float?
  requiredSlabs   Int?
  budget          Float?
  currency        String?
  attachments     Json?
  status          String    @default("NEW")
  priority        String    @default("MEDIUM")
  assigneeId      String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  assignee        User?     @relation(fields: [assigneeId], references: [id])
  customer        Customer? @relation(fields: [customerId], references: [id])
  stone           Stone?    @relation(fields: [stoneId], references: [id])
  order           Order?

  @@index([status])
  @@index([createdAt])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerId      String
  inquiryId       String?     @unique
  assigneeId      String?
  totalAmount     Float
  currency        String      @default("IRR")
  status          String      @default("PENDING")
  paymentStatus   String      @default("UNPAID")
  paymentMethod   String?
  shippingAddress String?
  shippingCost    Float?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  assignee        User?       @relation(fields: [assigneeId], references: [id])
  customer        Customer    @relation(fields: [customerId], references: [id])
  inquiry         Inquiry?    @relation(fields: [inquiryId], references: [id])
  items           OrderItem[]
  payments        Payment[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  stoneId   String
  quantity  Float
  unit      String  @default("SQM")
  unitPrice Float
  currency  String  @default("IRR")
  discount  Float   @default(0)
  total     Float
  notes     String?
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stone     Stone   @relation(fields: [stoneId], references: [id])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId])
}

model StoneAuditLog {
  id        String   @id @default(cuid())
  stoneId   String
  action    String
  oldValue  String?
  newValue  String?
  userId    String?
  createdAt DateTime @default(now())
  stone     Stone    @relation(fields: [stoneId], references: [id], onDelete: Cascade)

  @@index([stoneId])
  @@index([createdAt])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("GENERAL")
  type      String   @default("TEXT")
  updatedAt DateTime @updatedAt
}

model Exhibition {
  id          String    @id @default(cuid())
  name        String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model Payment {
  id             String    @id @default(cuid())
  orderId        String
  amount         Float
  currency       String    @default("IRR")
  gateway        String
  gatewayRefId   String?
  gatewayTrackId String?
  status         String    @default("PENDING")
  cardNumber     String?
  paidAt         DateTime?
  failureReason  String?
  callbackData   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  eventType  String
  entityType String?
  entityId   String?
  sessionId  String?
  userId     String?
  ipAddress  String?
  userAgent  String?
  referrer   String?
  country    String?
  city       String?
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
}

model ErpLog {
  id           String    @id @default(cuid())
  syncType     String
  status       String    @default("PENDING")
  recordType   String?
  recordId     String?
  erpRefCode   String?
  payload      String?
  response     String?
  errorMessage String?
  syncedAt     DateTime?
  createdAt    DateTime  @default(now())

  @@index([syncType])
  @@index([status])
}

model Recommendation {
  id                 String   @id @default(cuid())
  stoneId            String
  recommendedStoneId String
  score              Float
  reason             String
  createdAt          DateTime @default(now())

  @@index([stoneId])
}

model Notification {
  id          String                 @id @default(cuid())
  type        String
  title       String
  message     String
  recipientId String?
  isRead      Boolean                @default(false)
  data        String?
  createdAt   DateTime               @default(now())
  deliveries  NotificationDelivery[]

  @@index([recipientId, isRead])
  @@index([createdAt])
}

model NotificationDelivery {
  id             String       @id @default(cuid())
  notificationId String
  channel        String
  target         String
  status         String       @default("PENDING")
  providerRef    String?
  errorMessage   String?
  sentAt         DateTime?
  createdAt      DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId, status])
}

model Content {
  id          String   @id @default(cuid())
  section     String
  key         String
  type        String   @default("TEXT")
  value       String   @default("")
  label       String
  description String?
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([section, key], name: "section_key")
  @@index([section])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  target     String
  channel    String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([target, channel, expiresAt])
}

model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  label       String
  description String?
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  role         String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
}

model SalesStage {
  id        String      @id @default(cuid())
  name      String
  color     String?
  order     Int         @default(0)
  isWon     Boolean     @default(false)
  isLost    Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deals     SalesDeal[]
}

model SalesDeal {
  id         String      @id @default(cuid())
  customerId String
  title      String
  value      Float?
  currency   String?
  stageId    String
  ownerId    String?
  expectedAt DateTime?
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  quotations Quotation[]
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  owner      User?       @relation(fields: [ownerId], references: [id])
  stage      SalesStage  @relation(fields: [stageId], references: [id])

  @@index([customerId])
  @@index([stageId])
  @@index([ownerId])
}

model Quotation {
  id          String          @id @default(cuid())
  quotationNo String          @unique
  customerId  String
  dealId      String?
  status      String          @default("DRAFT")
  currency    String          @default("IRR")
  subtotal    Float           @default(0)
  discount    Float           @default(0)
  total       Float           @default(0)
  validUntil  DateTime?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  customer    Customer        @relation(fields: [customerId], references: [id])
  deal        SalesDeal?      @relation(fields: [dealId], references: [id])
  items       QuotationItem[]

  @@index([customerId])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  stoneId     String
  description String?
  quantity    Float
  unit        String    @default("SQM")
  unitPrice   Float
  discount    Float     @default(0)
  total       Float
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  stone       Stone     @relation(fields: [stoneId], references: [id])
}

model ErpConnection {
  id         String    @id @default(cuid())
  name       String
  baseUrl    String
  authType   String    @default("BEARER")
  secretRef  String
  isActive   Boolean   @default(true)
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([isActive])
}

model Job {
  id          String    @id @default(cuid())
  type        String
  payload     String
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  lockedAt    DateTime?
  completedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, availableAt])
}

model Webhook {
  id        String   @id @default(cuid())
  name      String
  url       String
  secret    String
  events    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model BackupRecord {
  id         String   @id @default(cuid())
  storageKey String
  size       Int
  checksum   String
  createdAt  DateTime @default(now())
  status     String   @default("COMPLETED")
  error      String?
}

model SiteConfig {
  id        String   @id @default(cuid())
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_configs")
}